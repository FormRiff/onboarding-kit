{
  "name": "@formriff/onboarding-angular",
  "version": "0.1.2",
  "description": "Standalone Angular adapters for Onboarding Kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormRiff/onboarding-kit.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/FormRiff/onboarding-kit#readme",
  "bugs": {
    "url": "https://github.com/FormRiff/onboarding-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/copy-assets.mjs",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit",
    "check:package": "publint dist && attw --pack dist --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@formriff/onboarding": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=21.2.26 <22",
    "@angular/core": ">=21.2.26 <22",
    "@angular/router": ">=21.2.26 <22",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "ng-packagr": "22.3.0",
    "rxjs": "^7.8.2",
    "typescript": "~7.0.2",
    "zone.js": "~0.16.0"
  }
}
